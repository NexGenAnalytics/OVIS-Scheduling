# in.lj_minimize_256k_105k
# 256k-atom LJ: hot melt (T 3), conjugate-gradient minimization, then NVE at T 0.5.
# Anchor of the minimize family. Same system as lj_base_256k_160k but a three-phase protocol.

units           lj
atom_style      atomic
boundary        p p p

variable        nhot equal 5000
variable        nsteps equal 100000

lattice         fcc 0.8442
region          box block 0 40 0 40 0 40
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create 3.0 87287 loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

thermo          100
thermo_style    custom step temp pe ke etotal press

fix             1 all nvt temp 3.0 3.0 0.5
run             ${nhot}
unfix           1

min_style       cg
minimize        0.0 1.0e-8 5000 50000

velocity        all create 0.5 4441 loop geom
fix             1 all nve
run             ${nsteps}
