# in.lj_pulse_1049k_168k
# LJ melt that spikes from 131k to 1.05M atoms (replicate) then drops back to 131k (deletion).
# Independent: single memory pulse. Same physics as lj_base_256k_160k.

units           lj
atom_style      atomic
boundary        p p p

variable        temp equal 1.0
variable        n1 equal 60000
variable        n2 equal 18000
variable        n3 equal 90000

lattice         fcc 0.8442
region          box block 0 32 0 32 0 32
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create ${temp} 87287 loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve

thermo          500
thermo_style    custom step atoms temp pe ke etotal press

run             ${n1}
replicate       2 2 2
run             ${n2}
delete_atoms    random fraction 0.875 yes all NULL 2207
run             ${n3}
