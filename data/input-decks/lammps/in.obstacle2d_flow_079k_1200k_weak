# in.obstacle2d_flow_079k_1200k_weak
# 2d obstacle flow with half the driving force.
# Variant of obstacle2d_flow_079k_1200k: driving force 1.0 -> 0.5 (expected impact: negligible).

units           lj
atom_style      atomic
dimension       2
boundary        p s p

variable        fx equal 0.5
variable        nsteps equal 1200000

neighbor        0.3 bin
neigh_modify    delay 5

lattice         hex 0.7
region          box block 0 400 0 100 -0.25 0.25
create_box      3 box
create_atoms    1 box

mass            * 1.0

pair_style      lj/cut 1.12246
pair_coeff      * * 1.0 1.0 1.12246

region          1 block INF INF INF 1.25 INF INF
group           lower region 1
region          2 block INF INF 98.75 INF INF INF
group           upper region 2
group           boundary union lower upper
group           flow subtract all boundary

set             group lower type 2
set             group upper type 3

compute         mobile flow temp
velocity        flow create 1.0 482748 temp mobile
fix             1 all nve
fix             2 flow temp/rescale 200 1.0 1.0 0.02 1.0
fix_modify      2 temp mobile

velocity        boundary set 0.0 0.0 0.0
fix             3 lower setforce 0.0 0.0 0.0
fix             4 upper setforce 0.0 NULL 0.0
fix             5 upper aveforce 0.0 -0.5 0.0
fix             6 flow addforce ${fx} 0.0 0.0

region          void1 sphere 50 30 0 10
delete_atoms    region void1
region          void2 sphere 150 70 0 10
delete_atoms    region void2
region          void3 sphere 250 40 0 10
delete_atoms    region void3
region          void4 sphere 350 60 0 10
delete_atoms    region void4

fix             7 flow indent 100 sphere 50 30 0 12
fix             8 flow indent 100 sphere 150 70 0 12
fix             9 flow indent 100 sphere 250 40 0 12
fix             10 flow indent 100 sphere 350 60 0 12
fix             11 all enforce2d

timestep        0.003
thermo          1000
thermo_modify   temp mobile

run             ${nsteps}
