# in.binary_lj_032k_150k
# 32,000-atom binary Lennard-Jones mixture

units           lj
atom_style      atomic
boundary        p p p

variable        nx equal 20
variable        rho equal 0.8442
variable        temp equal 1.0
variable        rc equal 2.5
variable        nsteps equal 150000

lattice         fcc ${rho}
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      2 box
create_atoms    1 box

set             type 1 type/fraction 2 0.5 24680

mass            1 1.0
mass            2 1.0

velocity        all create ${temp} 13579 loop geom

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0 ${rc}
pair_coeff      2 2 0.5 0.88 ${rc}
pair_coeff      1 2 1.5 0.8 ${rc}

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve

thermo          100
thermo_style    custom step temp pe ke etotal press density

run             ${nsteps}
