# in.lj_base_256k_160k_stressatom
# LJ melt tallying per-atom stress each thermo step.
# Variant of lj_base_256k_160k: adds compute stress/atom + reduce (expected impact: low).

units           lj
atom_style      atomic
boundary        p p p

variable        nx equal 40
variable        rho equal 0.8442
variable        temp equal 1.0
variable        rc equal 2.5
variable        nsteps equal 160000

lattice         fcc ${rho}
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create ${temp} 87287 loop geom

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0 ${rc}

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve

thermo          100
compute         satom all stress/atom NULL
compute         ssum all reduce sum c_satom[1] c_satom[2] c_satom[3]
thermo_style    custom step temp pe ke etotal press density c_ssum[1] c_ssum[2] c_ssum[3]

run             ${nsteps}
