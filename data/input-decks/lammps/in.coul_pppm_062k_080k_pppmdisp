# in.coul_pppm_062k_080k_pppmdisp
# Charged LJ melt with long-range dispersion (PPPM/disp).
# Variant of coul_pppm_062k_080k: pair lj/cut/coul/long -> lj/long/coul/long (single cutoff 6.0), kspace pppm -> pppm/disp (expected impact: high).
# Requires: KSPACE

units           lj
atom_style      charge
boundary        p p p

variable        nx equal 25
variable        rho equal 0.8442
variable        temp equal 1.5
variable        q equal 1.0
variable        rc_lj equal 2.5
variable        rc_coul equal 6.0
variable        nsteps equal 80000

lattice         fcc ${rho}
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 1 basis 3 2 basis 4 2

mass            * 1.0
set             type 1 charge ${q}
set             type 2 charge -${q}

velocity        all create ${temp} 99887 loop geom

pair_style      lj/long/coul/long long long ${rc_coul}
pair_coeff      * * 1.0 1.0
kspace_style    pppm/disp 1.0e-4
kspace_modify   force/disp/real 0.0001 force/disp/kspace 0.002

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.003
fix             1 all nvt temp ${temp} ${temp} 0.5

thermo          100
thermo_style    custom step temp pe ke etotal press elong

run             ${nsteps}
