# in.lj_meltquench_256k_200k
# 256k-atom LJ crystal heated 0.1 -> 2.5 then cooled back to 0.1 under NPT (P 0).
# Anchor of the meltquench family. Same system as lj_base_256k_160k with a temperature ramp protocol.

units           lj
atom_style      atomic
boundary        p p p

variable        nheat equal 100000
variable        ncool equal 100000

lattice         fcc 0.8442
region          box block 0 40 0 40 0 40
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create 0.1 87287 loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

thermo          100
thermo_style    custom step temp pe ke etotal press

fix             1 all npt temp 0.1 2.5 0.5 iso 0.0 0.0 5.0
run             ${nheat}
unfix           1
fix             1 all npt temp 2.5 0.1 0.5 iso 0.0 0.0 5.0
run             ${ncool}
