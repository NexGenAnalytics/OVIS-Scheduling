# in.lj_grid_1049k_160k_rho100_rc35
# 1,048,576-atom Lennard-Jones melt (fcc start, NVE), 160k steps, rho 1.0, cutoff 3.5.
# lj_grid sweep (PR #37): lj_base_256k_160k with nx=64, rho=1.0, rc=3.5.

units           lj
atom_style      atomic
boundary        p p p

variable        nx equal 64
variable        rho equal 1.0
variable        temp equal 1.0
variable        rc equal 3.5
variable        nsteps equal 160000

lattice         fcc ${rho}
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create ${temp} 87287 loop geom

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0 ${rc}

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve

thermo          100
thermo_style    custom step temp pe ke etotal press density

run             ${nsteps}
