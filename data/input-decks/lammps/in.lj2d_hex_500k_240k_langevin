# in.lj2d_hex_500k_240k_langevin
# 2d LJ fluid with a Langevin thermostat.
# Variant of lj2d_hex_500k_240k: nve -> nve + langevin (expected impact: moderate).

units           lj
atom_style      atomic
dimension       2
boundary        p p p

variable        nx equal 500
variable        temp equal 1.0
variable        rc equal 2.5
variable        nsteps equal 240000

lattice         hex 0.8
region          box block 0 ${nx} 0 ${nx} -0.5 0.5
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create ${temp} 21541 loop geom

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0 ${rc}

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve
fix             3 all langevin ${temp} ${temp} 1.0 7741
fix             2 all enforce2d

thermo          100
thermo_style    custom step temp pe ke etotal press

run             ${nsteps}
