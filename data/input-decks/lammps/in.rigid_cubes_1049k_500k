# in.rigid_cubes_1049k_500k
# 131,072 rigid 8-atom LJ cubes (1,048,576 atoms), rigid/small (multi-node).
# Variant of rigid_cubes_131k_160k: box 64^3 -> 128^3 and nsteps 160k -> 500k (expected impact: high).
# Requires: RIGID

units           lj
atom_style      bond
atom_modify     map array
boundary        p p p

variable        nsteps equal 500000

lattice         sc 1.0
region          box block 0 128 0 128 0 128
create_box      1 box
create_atoms    1 box

variable        odd atom "(floor(x/2)+floor(y/2)+floor(z/2)) % 2"
group           odd variable odd
delete_atoms    group odd

variable        bid atom 1+floor(x/2)+64*floor(y/2)+4096*floor(z/2)
set             group all mol v_bid

mass            1 1.0

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes exclude molecule/intra all

velocity        all create 1.5 33121 loop geom

fix             1 all rigid/small molecule

thermo          100
thermo_style    custom step temp pe ke etotal press

run             ${nsteps}
