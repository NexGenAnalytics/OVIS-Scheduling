# in.eam_cu_256k_080k
# 256,000-atom fcc copper, embedded-atom method (Cu_u3.eam), NVE from 1600 K, metal units, 80,000 steps.
# Anchor of the eam family. Held-out family for similarity tests: no other deck uses an EAM potential.
# Requires: MANYBODY; Cu_u3.eam from the LAMMPS potentials directory (run.sh sets LAMMPS_POTENTIALS).

units           metal
atom_style      atomic
boundary        p p p

variable        nx equal 40
variable        temp equal 1600.0
variable        nsteps equal 80000

lattice         fcc 3.615
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      1 box
create_atoms    1 box

pair_style      eam
pair_coeff      1 1 Cu_u3.eam

velocity        all create ${temp} 376847 loop geom

neighbor        1.0 bin
neigh_modify    delay 5 every 1 check yes

timestep        0.005
fix             1 all nve

thermo          100
thermo_style    custom step temp pe ke etotal press

run             ${nsteps}
