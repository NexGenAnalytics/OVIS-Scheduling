# in.mp_thermal_259k_200k
# Muller-Plathe thermal conductivity: kinetic-energy swaps and a temperature profile.
# Variant of mp_viscosity_259k_200k: fix viscosity -> fix thermal/conductivity, profile vx -> ke (expected impact: low).

units           lj
atom_style      atomic
boundary        p p p

variable        nsteps equal 200000

lattice         fcc 0.8442
region          box block 0 30 0 30 0 72
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create 1.0 87287 loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve
fix             2 all thermal/conductivity 100 z 20

compute         ke all ke/atom
variable        tatom atom c_ke*2/3
compute         layers all chunk/atom bin/1d z lower 0.05 units reduced
fix             prof all ave/chunk 100 10 1000 layers v_tatom file profile.mp_thermal

thermo          100
thermo_style    custom step temp pe ke etotal press f_2

run             ${nsteps}
