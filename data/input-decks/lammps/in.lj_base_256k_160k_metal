# in.lj_base_256k_160k_metal
# LJ argon melt in metal units (same reduced state as the anchor).
# Variant of lj_base_256k_160k: units lj -> metal with argon parameters (expected impact: negligible).

units           metal
atom_style      atomic
boundary        p p p

variable        nx equal 40
variable        temp equal 119.527
variable        rc equal 8.5125
variable        nsteps equal 160000

lattice         fcc 5.71903
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      1 box
create_atoms    1 box

mass            1 39.948

velocity        all create ${temp} 87287 loop geom

pair_style      lj/cut ${rc}
pair_coeff      1 1 0.0103 3.405 ${rc}

neighbor        1.0215 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.010794
fix             1 all nve

thermo          100
thermo_style    custom step temp pe ke etotal press density

run             ${nsteps}
