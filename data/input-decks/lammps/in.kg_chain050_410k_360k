# in.kg_chain050_410k_360k
# Larger Kremer-Grest melt (409,600 beads).
# Variant of kg_chain050_202k_360k: box 100x45x45 -> 100x64x64 (expected impact: high).
# Requires: MOLECULE

units           lj
atom_style      bond
boundary        p p p

variable        nx equal 100
variable        ny equal 64
variable        L equal 50
variable        nsteps equal 360000

lattice         custom 0.8520064 a1 0.97 0.0 0.0 a2 0.0 1.1 0.0 a3 0.0 0.0 1.1 basis 0.0 0.0 0.0
region          box block 0 ${nx} 0 ${ny} 0 ${ny}
create_box      1 box bond/types 1 extra/bond/per/atom 2 extra/special/per/atom 6
create_atoms    1 box
variable        ix atom floor(x/0.97+0.5)

mass            1 1.0

pair_style      lj/cut 1.122462
pair_modify     shift yes
pair_coeff      1 1 1.0 1.0 1.122462
bond_style      fene
bond_coeff      1 30.0 1.5 1.0 1.0
special_bonds   fene

neighbor        0.4 bin
neigh_modify    delay 0 every 1 check yes
comm_modify     cutoff 2.0

create_bonds    many all all 1 0.96 0.98
variable        cut atom "(v_ix % v_L) == 0 || (v_ix % v_L) == (v_L-1)"
group           chainends variable cut
delete_bonds    chainends bond 1 remove special

velocity        all create 1.0 53124 loop geom

timestep        0.01
fix             1 all nve
fix             2 all langevin 1.0 1.0 10.0 90210

thermo          500
thermo_style    custom step temp pe ebond press

run             ${nsteps}
