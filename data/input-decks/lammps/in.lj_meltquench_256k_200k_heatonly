# in.lj_meltquench_256k_200k_heatonly
# 256k-atom LJ crystal heated 0.1 -> 2.5 over the full run (no quench).
# Variant of lj_meltquench_256k_200k: second stage cools 2.5 -> 0.1 replaced by holding at 2.5 (expected impact: moderate).

units           lj
atom_style      atomic
boundary        p p p

variable        nheat equal 100000
variable        ncool equal 100000

lattice         fcc 0.8442
region          box block 0 40 0 40 0 40
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create 0.1 87287 loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

thermo          100
thermo_style    custom step temp pe ke etotal press

fix             1 all npt temp 0.1 2.5 0.5 iso 0.0 0.0 5.0
run             ${nheat}
unfix           1
fix             1 all npt temp 2.5 2.5 0.5 iso 0.0 0.0 5.0
run             ${ncool}
