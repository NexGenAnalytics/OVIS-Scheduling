# in.lj2d_hex_15995k_200k
# 15,995,168-atom 2d Lennard-Jones fluid (multi-node).
# Variant of lj2d_hex_500k_240k: nx 500 -> 2828 and nsteps 240k -> 200k (expected impact: high).

units           lj
atom_style      atomic
dimension       2
boundary        p p p

variable        nx equal 2828
variable        temp equal 1.0
variable        rc equal 2.5
variable        nsteps equal 200000

lattice         hex 0.8
region          box block 0 ${nx} 0 ${nx} -0.5 0.5
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create ${temp} 21541 loop geom

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0 ${rc}

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve
fix             2 all enforce2d

thermo          100
thermo_style    custom step temp pe ke etotal press

run             ${nsteps}
