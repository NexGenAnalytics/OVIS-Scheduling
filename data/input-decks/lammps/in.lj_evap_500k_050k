# in.lj_evap_500k_050k
# 500,000-atom LJ melt with random atom removal (800 every 100 steps, ends near 100k atoms).
# Related to lj_base_256k_160k: nx 40 -> 50, nsteps 160k -> 50k, plus fix evaporate (expected impact: high, CPU falls over the run).

units           lj
atom_style      atomic
boundary        p p p

variable        nx equal 50
variable        rho equal 0.8442
variable        temp equal 1.0
variable        rc equal 2.5
variable        nsteps equal 50000
variable        nevap equal 800

lattice         fcc ${rho}
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create ${temp} 87287 loop geom

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0 ${rc}

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve
fix             2 all evaporate 100 ${nevap} box 3517

thermo          100
thermo_style    custom step atoms temp pe ke etotal press density

run             ${nsteps}
