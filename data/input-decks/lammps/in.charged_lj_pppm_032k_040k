# in.charged_lj_pppm_032k_040k
# 32,000-atom charged Lennard-Jones system with long-range Coulomb PPPM

units           lj
atom_style      charge
boundary        p p p

variable        nx equal 20
variable        rho equal 0.8442
variable        temp equal 1.0
variable        rc_lj equal 2.5
variable        rc_coul equal 10.0
variable        nsteps equal 40000

lattice         fcc ${rho}
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
region          left block 0 10 0 ${nx} 0 ${nx}
region          right block 10 ${nx} 0 ${nx} 0 ${nx}

create_box      2 box
create_atoms    1 box

set             region right type 2
set             type 1 charge 1.0
set             type 2 charge -1.0

mass            1 1.0
mass            2 1.0

velocity        all create ${temp} 99887 loop geom

pair_style      lj/cut/coul/long ${rc_lj} ${rc_coul}
pair_coeff      1 1 1.0 1.0 ${rc_lj}
pair_coeff      2 2 1.0 1.0 ${rc_lj}
pair_coeff      1 2 1.0 1.0 ${rc_lj}

kspace_style    pppm 1.0e-4

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve

thermo          100
thermo_style    custom step temp pe ke etotal press density

run             ${nsteps}
