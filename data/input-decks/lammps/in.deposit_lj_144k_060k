# in.deposit_lj_144k_060k
# LJ vapor deposition: 50,000 atoms deposited one per step onto a 93,600-atom substrate.
# Anchor of the deposit family. Independent of the bulk decks (open surface, atom count ramps up).

units           lj
atom_style      atomic
boundary        p p f

variable        ndep equal 50000
variable        every equal 1
variable        tsub equal 0.5
variable        nsteps equal 60000

lattice         fcc 0.8442
region          box block 0 60 0 60 0 30
region          substrate block 0 60 0 60 0 6
create_box      2 box
create_atoms    1 region substrate

mass            * 1.0

pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

region          bottom block INF INF INF INF 0 1.5
group           bottom region bottom
group           substrate type 1
group           mobile subtract substrate bottom
group           addatoms type 2

velocity        mobile create ${tsub} 5812775 loop geom

fix             1 bottom setforce 0.0 0.0 0.0
fix             2 mobile nve
fix             3 mobile langevin ${tsub} ${tsub} 0.5 83271
fix             4 addatoms nve

region          source block 0 60 0 60 26 28
fix             5 addatoms deposit ${ndep} 2 ${every} 12345 region source near 1.0 vz -1.0 -1.0
fix             6 all wall/reflect zhi EDGE

thermo_style    custom step atoms temp epair etotal press
thermo          1000
thermo_modify   lost ignore

run             ${nsteps}
