# in.lj_evap_8002k_100k
# 8,001,504-atom LJ melt losing 7,000 atoms every 100 steps (ends near 1M atoms, multi-node).
# Variant of lj_evap_500k_050k: nx 50 -> 126, removal 800 -> 7000 per 100 steps, nsteps 50k -> 100k (expected impact: high).

units           lj
atom_style      atomic
boundary        p p p

variable        nx equal 126
variable        rho equal 0.8442
variable        temp equal 1.0
variable        rc equal 2.5
variable        nsteps equal 100000
variable        nevap equal 7000

lattice         fcc ${rho}
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create ${temp} 87287 loop geom

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0 ${rc}

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve
fix             2 all evaporate 100 ${nevap} box 3517

thermo          100
thermo_style    custom step atoms temp pe ke etotal press density

run             ${nsteps}
