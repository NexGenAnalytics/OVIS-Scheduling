# in.lj_base_256k_160k_msd
# LJ melt reporting mean-squared displacement.
# Variant of lj_base_256k_160k: adds compute msd to thermo output (expected impact: low).

units           lj
atom_style      atomic
boundary        p p p

variable        nx equal 40
variable        rho equal 0.8442
variable        temp equal 1.0
variable        rc equal 2.5
variable        nsteps equal 160000

lattice         fcc ${rho}
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create ${temp} 87287 loop geom

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0 ${rc}

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve

thermo          100
compute         msd all msd
thermo_style    custom step temp pe ke etotal press density c_msd[4]

run             ${nsteps}
