# in.lj_melt_032k_170k_seedB
# 32,000-atom Lennard-Jones melt, 170,000 timesteps, seed B

units           lj
atom_style      atomic
boundary        p p p

variable        nx equal 20
variable        rho equal 0.8442
variable        temp equal 1.0
variable        rc equal 2.5
variable        nsteps equal 170000

lattice         fcc ${rho}
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create ${temp} 31917 loop geom

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0 ${rc}

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nve

thermo          100
thermo_style    custom step temp pe ke etotal press density

run             ${nsteps}
