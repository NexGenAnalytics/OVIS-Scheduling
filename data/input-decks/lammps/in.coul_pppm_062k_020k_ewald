# in.coul_pppm_062k_020k_ewald
# Charged LJ melt with standard Ewald summation, 20k steps.
# Variant of coul_pppm_062k_080k: kspace pppm -> ewald, nsteps 80k -> 20k (expected impact: high).
# Requires: KSPACE

units           lj
atom_style      charge
boundary        p p p

variable        nx equal 25
variable        rho equal 0.8442
variable        temp equal 1.5
variable        q equal 1.0
variable        rc_lj equal 2.5
variable        rc_coul equal 6.0
variable        nsteps equal 20000

lattice         fcc ${rho}
region          box block 0 ${nx} 0 ${nx} 0 ${nx}
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 1 basis 3 2 basis 4 2

mass            * 1.0
set             type 1 charge ${q}
set             type 2 charge -${q}

velocity        all create ${temp} 99887 loop geom

pair_style      lj/cut/coul/long ${rc_lj} ${rc_coul}
pair_coeff      * * 1.0 1.0
kspace_style    ewald 1.0e-4

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.003
fix             1 all nvt temp ${temp} ${temp} 0.5

thermo          100
thermo_style    custom step temp pe ke etotal press elong

run             ${nsteps}
