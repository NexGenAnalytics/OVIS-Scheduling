# in.hybrid_ljmorse_256k_300k
# 256k-atom 50:50 binary with hybrid LJ (1-1, 1-2) and Morse (2-2) interactions, NVT.
# Independent: hybrid pair style. Combines the physics of binary_lj_032k_150k and morse_fluid_032k_120k.

units           lj
atom_style      atomic
boundary        p p p

variable        nsteps equal 300000

lattice         fcc 0.8442
region          box block 0 40 0 40 0 40
create_box      2 box
create_atoms    1 box
set             type 1 type/fraction 2 0.5 24680

mass            * 1.0

velocity        all create 1.0 13579 loop geom

pair_style      hybrid lj/cut 2.5 morse 2.5
pair_coeff      1 1 lj/cut 1.0 1.0
pair_coeff      1 2 lj/cut 1.2 1.0
pair_coeff      2 2 morse 1.0 6.0 1.122462

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nvt temp 1.0 1.0 0.5

thermo          100
thermo_style    custom step temp pe ke etotal press

run             ${nsteps}
