# in.gran_pour_120k_200k_poly
# Granular pour with polydisperse diameters 0.7-1.2 (slower insertion).
# Variant of gran_pour_120k_200k: monodisperse -> diam range 0.7 1.2 (expected impact: moderate).
# Requires: GRANULAR

units           lj
atom_style      sphere
boundary        p p fm
newton          off
comm_modify     vel yes

variable        npour equal 120000
variable        nsteps equal 200000

region          reg block -30 30 -30 30 0 80 units box
create_box      1 reg

neighbor        0.2 bin
neigh_modify    delay 0

pair_style      gran/hooke/history 2000.0 NULL 50.0 NULL 0.5 0
pair_coeff      * *

timestep        0.001

fix             1 all nve/sphere
fix             2 all gravity 1.0 spherical 0.0 -180.0
fix             zlower all wall/gran hooke/history 2000.0 NULL 50.0 NULL 0.5 0 zplane 0.0 2000.0

region          slab block -29 29 -29 29 70 76 units box
fix             ins all pour ${npour} 1 300719 vol 0.2 50 region slab diam range 0.7 1.2

compute         1 all erotate/sphere
thermo_style    custom step atoms ke c_1 vol
thermo          1000
thermo_modify   lost ignore norm no
compute_modify  thermo_temp dynamic/dof yes

run             ${nsteps}
