# in.lj_shear3d_256k_160k
# 3d NEMD shear (SLLOD + deforming triclinic box) of 256k LJ atoms.
# Independent: 3d counterpart of nemd2d_shear_144k_600k; same fluid as lj_base_256k_160k in a sheared triclinic box.

units           lj
atom_style      atomic
boundary        p p p

variable        erate equal 0.05
variable        nsteps equal 160000

lattice         fcc 0.8442
region          box prism 0 40 0 40 0 40 0 0 0
create_box      1 box
create_atoms    1 box

mass            1 1.0

velocity        all create 1.0 87287 loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

fix             1 all nvt/sllod temp 1.0 1.0 0.5
fix             2 all deform 1 xy erate ${erate} remap v flip yes

thermo          100
thermo_style    custom step temp pe ke etotal press pxy

run             ${nsteps}
